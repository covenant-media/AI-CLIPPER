# ---------------------------------------------------------------- AI provider
# At least one of these is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# auto | claude | openai | gemini
AI_PROVIDER=auto
# Optional base URLs for self-hosted / relay endpoints.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------- AI model selection
# MUST be a model your endpoint actually serves, otherwise you get a provider
# 503 ("no available channel") and the run falls through to the next entry.
AI_MODEL=
# Comma separated extra models to try, in order, before giving up.
# Entries are auto-routed to the provider matching their name prefix.
# AI_FALLBACK_MODELS=claude-3-5-sonnet-20241022,gpt-4o,gemini-1.5-pro
# Per-provider overrides (win over AI_MODEL).
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# GEMINI_MODEL=
# How many times the HTTP SDK may retry the SAME target. 0 = skip immediately.
AI_MAX_RETRIES=0
# If every AI provider fails, pick clips with a local transcript heuristic
# instead of crashing the pipeline. Set to false to fail loudly instead.
AI_HEURISTIC_FALLBACK=true

# ------------------------------------------------------------ transcription
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# Force a language to skip Whisper's detection pass (e.g. en for English).
# Leave blank to auto-detect - auto-detect is usually right, and pinning the
# wrong language makes Whisper *translate* the audio instead of transcribing it
# (forcing "en" on Yoruba speech yields broken English).
WHISPER_LANGUAGE=
# Segments decoded per batch. Lower = less RAM, higher = usually faster.
WHISPER_BATCH_SIZE=16
# Voice-activity-detection backend: pyannote (default) or silero.
#   pyannote - works offline out of the box, but it is the slowest part of
#              Stage 2 on CPU (it runs over the whole file before transcription).
#   silero   - much faster on CPU. Downloads from GitHub via torch.hub on first
#              use; if that is unavailable the run continues with pyannote.
WHISPER_VAD_METHOD=pyannote
# Print a "Progress: N%" line as Whisper decodes each segment (set false for
# quiet CI logs). Without it Stage 2 prints nothing for minutes on CPU.
WHISPER_PROGRESS=true
# CPU threads for decoding. 0 = every logical core; set e.g. 4 to keep the
# machine responsive (WhisperX's own default is 4).
WHISPER_THREADS=0
# Override the wav2vec2 alignment model for languages WhisperX has no default
# for (e.g. ALIGN_MODEL=chrisjay/wav2vec2-large-xlsr-53-yoruba).
# ALIGN_MODEL=none switches word-level alignment off entirely - it is a model
# download plus a full CPU pass, and the clip heuristic never uses word timings.
ALIGN_MODEL=
# Needed only for speaker diarization.
HF_TOKEN=

# ------------------------------------------------------------- performance
# Process every Nth+1 frame during scene detection. 0 = every frame (accurate).
# 2-3 roughly halves/thirds the stage on high framerate footage.
SCENE_FRAME_SKIP=0
# When no cuts are detected at all, split at this many seconds so clip edges
# can still snap. 0 = disable.
SCENE_FALLBACK_INTERVAL=0
